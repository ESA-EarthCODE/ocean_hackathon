   "outputs": [],
   "source": [
    "# set styling data\n",
    "habitat_color = \"#29ac32\"\n",
    "confidence_colors = {\n",
    "    \"Very high confidence\": \"#faebdd\",\n",
    "    \"High confidence\": \"#f58860\",\n",
    "    \"Moderate confidence\": \"#cb1b4f\",\n",
    "    \"Low confidence\": \"#611f53\",\n",
    "    \"Very low confidence\": \"#03051a\",\n",
    "}\n",
    "carbon_bins = [0, 50, 100, 150, 200, 250, 300, 350, 500]\n",
    "carbon_cmap = ListedColormap([\"#f0f9e8\", \"#d1edcf\", \"#b1e1bd\", \"#8dd3c2\",\n",
    "                              \"#6bc0c6\", \"#4ba8c9\", \"#2a89bd\", \"#0868ac\"])\n",
    "carbon_cmap.set_under(\"#bdbdbd\")\n",
    "carbon_cmap.set_over(\"#bdbdbd\")\n",
    "carbon_norm = BoundaryNorm(carbon_bins, carbon_cmap.N)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "09ad1529-a94b-48c3-a1f1-723f0d624198",
   "metadata": {},
   "outputs": [],
   "source": [
    "# convert to lon,lat for cartopy\n",
    "carbon = carbon.to_crs(epsg=4326)\n",
    "polygons = polygons.to_crs(epsg=4326)\n",
    "grid = grid.to_crs(epsg=4326)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "7bc71984",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1500x1200 with 5 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "projection = ccrs.PlateCarree()\n",
    "fig, axes = plt.subplots(2, 2, figsize=(15, 12), subplot_kw={\"projection\": projection})\n",
    "for ax in axes.flat:\n",
    "    ax.set_facecolor(\"#eaf2f5\")\n",
    "    ax.add_feature(cfeature.LAND.with_scale(\"10m\"), facecolor=\"#eee9dc\")\n",
    "    ax.coastlines(resolution=\"10m\", linewidth=0.6)\n",
    "    labels = ax.gridlines(draw_labels=True, linewidth=0.3, alpha=0.4)\n",
    "    labels.top_labels = labels.right_labels = False\n",
    "\n",
    "locator, habitat, confidence, stocks = axes.flat\n",
    "locator.set_extent([0.0, 5.0, 38.0, 41.5], crs=projection)\n",
    "locator.add_patch(Rectangle((BOUNDS[0], BOUNDS[1]), BOUNDS[2]-BOUNDS[0], BOUNDS[3]-BOUNDS[1],\n",
    "                            fill=False, edgecolor=\"#c72535\", linewidth=2, transform=projection))\n",
    "locator.text(2.6, 39.65, \"Mallorca\", transform=projection, fontsize=10)\n",
    "locator.text(1.1, 39.1, \"Ibiza\", transform=projection, fontsize=10)\n",
    "locator.text(3.7, 40.15, \"Menorca\", transform=projection, fontsize=10)\n",
    "locator.set_title(\"Balearic Islands · 2024\")\n",
    "for ax in (habitat, confidence, stocks):\n",
    "    ax.set_extent([BOUNDS[0], BOUNDS[2], BOUNDS[1], BOUNDS[3]], crs=projection)\n",
    "\n",
    "habitat.add_geometries(polygons.geometry, projection, facecolor=habitat_color,\n",
    "                       edgecolor=\"white\", linewidth=0.05)\n",
    "habitat.set_title(\"HAB-MAP-POLY · Posidonia meadows\")\n",
    "habitat.legend(handles=[Patch(color=habitat_color, label=\"Posidonia\")], loc=\"upper left\")\n",
    "confidence.add_geometries(grid.geometry, projection,\n",
    "                          facecolor=grid.confidence_legend.map(confidence_colors).fillna(\"#bdbdbd\").tolist(),\n",
    "                          edgecolor=\"none\")\n",
    "confidence.set_title(\"HAB-MAP-GRID · Confidence\")\n",
    "confidence.legend(handles=[Patch(color=color, label=label) for label, color in confidence_colors.items()],\n",
    "                  loc=\"upper left\", fontsize=8)\n",
    "stocks.add_geometries(carbon.geometry, projection,\n",
    "                       facecolor=carbon_cmap(carbon_norm(carbon.mean_carbon_stocks)), edgecolor=\"none\")\n",
    "stocks.set_title(\"CARB-MAP · Carbon stock density\")\n",
    "fig.colorbar(plt.cm.ScalarMappable(norm=carbon_norm, cmap=carbon_cmap), ax=stocks,\n",
    "             orientation=\"horizontal\", pad=0.1, shrink=0.85, label=\"Carbon stock (Mg/ha)\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
