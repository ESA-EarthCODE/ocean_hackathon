   "source": [
    "\n",
    "fig, ax = plt.subplots(\n",
    "    figsize=(12, 7),\n",
    "    subplot_kw={\"projection\": ccrs.PlateCarree()}\n",
    ")\n",
    "\n",
    "# Plot speed as background\n",
    "pcm = ax.pcolormesh(\n",
    "    ds_t.lon,\n",
    "    ds_t.lat,\n",
    "    speed,\n",
    "    cmap=\"viridis\",\n",
    "    shading=\"auto\",\n",
    "    transform=ccrs.PlateCarree()\n",
    ")\n",
    "\n",
    "# Subsample vectors so arrows do not overlap\n",
    "step = 5\n",
    "\n",
    "q = ax.quiver(\n",
    "    ds_t.lon.values[::step],\n",
    "    ds_t.lat.values[::step],\n",
    "    u.values[::step, ::step],\n",
    "    v.values[::step, ::step],\n",
    "    transform=ccrs.PlateCarree(),\n",
    "    scale=10,\n",
    "    width=0.002,\n",
    "    color=\"black\"\n",
    ")\n",
    "\n",
    "# Reference arrow\n",
    "ax.quiverkey(\n",
    "    q,\n",
    "    X=0.9,\n",
    "    Y=1.03,\n",
    "    U=0.5,\n",
    "    label=\"0.5 m s$^{-1}$\",\n",
    "    labelpos=\"E\"\n",
    ")\n",
    "\n",
    "ax.coastlines(resolution=\"10m\")\n",
    "ax.add_feature(cfeature.LAND, facecolor=\"lightgray\")\n",
    "ax.add_feature(cfeature.BORDERS, linewidth=0.5)\n",
    "\n",
    "\n",
    "# Colorbar\n",
    "cbar = fig.colorbar(\n",
    "    pcm,\n",
    "    ax=ax,\n",
    "    orientation=\"vertical\",\n",
    "    pad=0.02\n",
    ")\n",
    "cbar.set_label(\"Current speed [m s$^{-1}$]\")\n",
    "\n",
    "actual_time = np.datetime_as_string(ds_t.time.values, unit=\"h\")\n",
    "\n",
    "ax.set_title(\n",
    "    f\"Total ocean current (CMEMS)\\n{actual_time}\"\n",
    ")\n",
    "\n",
    "plt.show()"
   ]
  }
