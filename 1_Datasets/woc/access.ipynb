    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import cartopy.crs as ccrs\n",
    "import cartopy.feature as cfeature\n",
    "\n",
    "# Choose timestamp\n",
    "timestamp = \"2016-06-1T15:00:00\"\n",
    "\n",
    "# Select nearest available time and remove singleton depth dimension\n",
    "ds_t = ds.sel(time=timestamp, method=\"nearest\").squeeze(\"depth\")\n",
    "\n",
    "# Vector components\n",
    "u = ds_t[\"ut_woc\"]\n",
    "v = ds_t[\"vt_woc\"]\n",
    "\n",
    "# Current speed\n",
    "speed = np.hypot(u, v)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "6db6a7dd-56b7-4dc5-a535-996df838225a",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-11-15T00:43:49.204957Z",
     "iopub.status.busy": "2026-11-15T00:43:49.204824Z",
     "iopub.status.idle": "2026-11-15T00:44:02.379929Z",
     "shell.execute_reply": "2026-11-15T00:44:02.379559Z"
    }
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1200x700 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
